#!/usr/bin/expect -f
set diskdir [lindex $argv 0]
set logfile [lindex $argv 1]
set command [lindex $argv 2]
set follow [lindex $argv 3]
set timeout 60
log_file -noappend $logfile
spawn cpmsim -z -d $diskdir
expect "A>"
send -- "$command\r"
expect -re {[AB]>}
if {$follow ne ""} {
    send -- "$follow\r"
    expect -re {[AB]>}
}
send "\034"
expect eof

