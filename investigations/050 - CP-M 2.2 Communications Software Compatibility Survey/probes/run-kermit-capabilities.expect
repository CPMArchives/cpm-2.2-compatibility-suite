#!/usr/bin/expect -f
set timeout 20
set send_slow {1 0.04}
set root [file normalize [file join [file dirname [info script]] ..]]
set emu "<project-root>/investigations/049 - CP-M 2.2 Application Compatibility Survey/probes/mosteksim"
set work [file join $root work]
log_file -noappend [file join $root probes transcripts kermit-capabilities-raw.txt]
spawn -noecho $emu -z -d [file join $work disks] -r [file join $work roms] -c [file join $work config-kermit.txt]
expect "A>"
send -s "b:\r"
expect "B>"
send -s "kermit\r"
expect "Kermit-80   0B:>"
send -s "set speed 9600\r"
expect "Kermit-80   0B:>"
send -s "break\r"
expect "Kermit-80   0B:>"
send -s "send absent50.bin\r"
expect "Kermit-80   0B:>"
send -s "exit\r"
expect "B>"
send "\034"
expect ">>>"
send "q\n"
expect eof
