#!/usr/bin/expect -f
set timeout 15
set send_slow {1 0.04}
set root [file normalize [file join [file dirname [info script]] ..]]
set emu "<project-root>/investigations/049 - CP-M 2.2 Application Compatibility Survey/probes/mosteksim"
set work [file join $root work]
log_file -noappend [file join $root probes transcripts qterm-profile-raw.txt]
spawn -noecho $emu -z -d [file join $work disks] -r [file join $work roms] -c [file join $work config-kermit.txt]
expect "A>"
send -s "b:\r"
expect "B>"
send -s "qterm\r"
expect "QTERM  V4.3e"
after 500
send "\036?"
after 500
send "\036i"
after 500
send "\036u"
expect "Enter modem channel A or B:"
send "b\r"
after 500
send "AT\r"
after 500
send "\036q"
expect "B>"
send "\034"
expect ">>>"
send "q\n"
expect eof
