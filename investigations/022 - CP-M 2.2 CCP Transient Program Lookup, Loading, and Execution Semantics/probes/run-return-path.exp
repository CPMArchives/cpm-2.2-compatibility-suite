#!/usr/bin/expect -f
set diskdir [lindex $argv 0]
set logfile [lindex $argv 1]
set termcmd [lindex $argv 2]
set timeout 30
log_file -noappend $logfile
spawn cpmsim -z -d $diskdir
expect "A>"
send "B:\r"
expect "B>"
send "USER 1\r"
expect "B>"
send "$termcmd\r"
expect "B>"
send "STATE22 AFTER-$termcmd\r"
expect "B>"
send "\034"
expect eof
