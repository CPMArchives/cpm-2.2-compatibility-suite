; Investigation 012 delete/rename probe
; Build: z80asm -fb -oDELREN012.COM DELREN012.ASM
	ORG 0100H
START:
	LD SP,STACKTOP
	LD DE,HEADER
	LD C,9
	CALL 0005H

	LD HL,FDELONE
	LD DE,LSDB
	CALL SEARCHREPORT
	LD HL,FDELONE
	CALL LOADFCB
	LD C,19
	CALL CALLFCB
	LD DE,LDELONE
	CALL REPORT
	LD HL,FDELONE
	LD DE,LSDA
	CALL SEARCHREPORT

	LD HL,FNOFILE
	CALL LOADFCB
	LD C,19
	CALL CALLFCB
	LD DE,LDELNO
	CALL REPORT

	LD HL,FWILD
	LD DE,LSWB
	CALL SEARCHREPORT
	LD HL,FWILD
	CALL LOADFCB
	LD C,19
	CALL CALLFCB
	LD DE,LDELWILD
	CALL REPORT
	LD HL,FWILD
	LD DE,LSWA
	CALL SEARCHREPORT

	; Open, delete by another FCB, then read through original open FCB.
	LD HL,FOPENDEL
	CALL LOADFCB
	LD C,15
	CALL CALLFCB
	XOR A
	LD (FCB+32),A
	LD HL,FCB
	LD DE,SAVEDFCB
	LD BC,36
	LDIR
	LD HL,FOPENDEL
	CALL LOADFCB
	LD C,19
	CALL CALLFCB
	LD HL,SAVEDFCB
	LD DE,FCB
	LD BC,36
	LDIR
	LD DE,BUF
	LD C,26
	CALL 0005H
	LD C,20
	CALL CALLFCB
	LD DE,LOPENDEL
	CALL REPORT

	; Delete then recreate/write; allocation reuse is visible in FCB/directory.
	LD HL,FREUSE
	LD DE,LSRB
	CALL SEARCHREPORT
	LD HL,FREUSE
	CALL LOADFCB
	LD C,19
	CALL CALLFCB
	LD HL,FREUSE
	CALL LOADFCB
	LD C,22
	CALL CALLFCB
	LD A,'N'
	CALL FILLBUF
	LD C,21
	CALL CALLFCB
	LD DE,LREWRITE
	CALL REPORT
	LD C,16
	CALL CALLFCB
	LD HL,FREUSE
	LD DE,LSRA
	CALL SEARCHREPORT

	; Explicit B delete.
	LD HL,FBDEL
	CALL LOADFCB
	LD C,19
	CALL CALLFCB
	LD DE,LBDEL
	CALL REPORT

	; User isolation: user 0 cannot see user 1, user 1 can delete it.
	LD HL,FU1
	CALL LOADFCB
	LD C,19
	CALL CALLFCB
	LD DE,LU0DEL
	CALL REPORT
	LD E,1
	LD C,32
	CALL 0005H
	LD HL,FU1
	CALL LOADFCB
	LD C,19
	CALL CALLFCB
	LD DE,LU1DEL
	CALL REPORT
	LD E,0
	LD C,32
	CALL 0005H

	; Simple rename and search both identities.
	LD HL,ROLDNEW
	CALL LOADREN
	LD C,23
	CALL CALLFCB
	LD DE,LRENAME
	CALL REPORT
	LD HL,FOLD
	LD DE,LSOLD
	CALL SEARCHREPORT
	LD HL,FNEW
	LD DE,LSNEW
	CALL SEARCHREPORT

	; Destination exists: outside documented safety; DRI creates duplicate.
	LD HL,RSRCDEST
	CALL LOADREN
	LD C,23
	CALL CALLFCB
	LD DE,LRENDEST
	CALL REPORT

	LD HL,RNOSRC
	CALL LOADREN
	LD C,23
	CALL CALLFCB
	LD DE,LRENNONE
	CALL REPORT

	; Wildcard source/destination behavior.
	LD HL,RWILD
	CALL LOADREN
	LD C,23
	CALL CALLFCB
	LD DE,LRENWILD
	CALL REPORT
	LD HL,FXREN
	LD DE,LSXREN
	CALL SEARCHREPORT

	; Explicit B rename.
	LD HL,RBOLDNEW
	CALL LOADREN
	LD C,23
	CALL CALLFCB
	LD DE,LBREN
	CALL REPORT

	; Rename an open file, then read through old activated FCB.
	LD HL,FOPNREN
	CALL LOADFCB
	LD C,15
	CALL CALLFCB
	XOR A
	LD (FCB+32),A
	LD HL,FCB
	LD DE,SAVEDFCB
	LD BC,36
	LDIR
	LD HL,ROPNREN
	CALL LOADREN
	LD C,23
	CALL CALLFCB
	LD HL,SAVEDFCB
	LD DE,FCB
	LD BC,36
	LDIR
	LD C,20
	CALL CALLFCB
	LD DE,LOPNREN
	CALL REPORT
	RET

CALLFCB:
	LD DE,FCB
	CALL 0005H
	LD (RESULT),A
	RET
LOADFCB:
	LD DE,FCB
	LD BC,16
	LDIR
	XOR A
	LD HL,FCB+16
	LD B,20
LF0: LD (HL),A
	INC HL
	DJNZ LF0
	RET
LOADREN:
	LD DE,FCB
	LD BC,32
	LDIR
	XOR A
	LD HL,FCB+32
	LD B,4
LR0: LD (HL),A
	INC HL
	DJNZ LR0
	RET
FILLBUF:
	LD HL,BUF
	LD (HL),A
	INC HL
	LD B,127
	XOR A
FB0: LD (HL),A
	INC HL
	DJNZ FB0
	RET

; HL exact/wild template, DE label; result plus matching directory entry.
SEARCHREPORT:
	PUSH DE
	CALL LOADFCB
	LD DE,BUF
	LD C,26
	CALL 0005H
	LD DE,FCB
	LD C,17
	CALL 0005H
	LD (RESULT),A
	LD B,A
	POP HL
	CALL PUTS
	LD A,(RESULT)
	CALL HEXBYTE
	LD E,' '
	CALL PUTC
	LD A,B
	CP 4
	JR NC,SEND
	RRCA
	RRCA
	RRCA
	AND 60H
	LD E,A
	LD D,0
	LD HL,BUF
	ADD HL,DE
	LD B,32
SD0: LD A,(HL)
	INC HL
	PUSH HL
	CALL HEXBYTE
	LD E,' '
	CALL PUTC
	POP HL
	DJNZ SD0
SEND: CALL CRLF
	RET

REPORT:
	PUSH DE
	LD C,25
	CALL 0005H
	LD (CURDISK),A
	POP HL
	CALL PUTS
	LD A,(RESULT)
	CALL HEXBYTE
	LD E,' '
	CALL PUTC
	LD A,(CURDISK)
	CALL HEXBYTE
	LD E,' '
	CALL PUTC
	LD HL,FCB
	LD B,33
RD0: LD A,(HL)
	INC HL
	PUSH HL
	CALL HEXBYTE
	LD E,' '
	CALL PUTC
	POP HL
	DJNZ RD0
	LD A,(BUF)
	CALL HEXBYTE
	CALL CRLF
	RET
PUTC:
	PUSH BC
	PUSH DE
	PUSH HL
	LD C,2
	CALL 0005H
	POP HL
	POP DE
	POP BC
	RET
PUTS: LD A,(HL)
	INC HL
	OR A
	RET Z
	LD E,A
	CALL PUTC
	JR PUTS
CRLF: LD E,13
	CALL PUTC
	LD E,10
	JP PUTC
HEXBYTE:
	PUSH AF
	RRCA
	RRCA
	RRCA
	RRCA
	CALL NIBBLE
	POP AF
NIBBLE:
	AND 0FH
	ADD A,'0'
	CP '9'+1
	JR C,NOUT
	ADD A,7
NOUT: LD E,A
	JP PUTC

; dr,name,type,ex,s1,s2,rc
FDELONE: DB 0,'DELONE  ','DAT',0,0,0,0
FNOFILE: DB 0,'NOFILE  ','DAT',0,0,0,0
FWILD: DB 0,'WILD?   ','DAT',0,0,0,0
FOPENDEL: DB 0,'OPENDEL ','DAT',0,0,0,0
FREUSE: DB 0,'REUSE   ','DAT',0,0,0,0
FBDEL: DB 2,'BDEL    ','DAT',0,0,0,0
FU1: DB 0,'U1FILE  ','DAT',0,0,0,0
FOLD: DB 0,'OLDNAME ','DAT',0,0,0,0
FNEW: DB 0,'NEWNAME ','DAT',0,0,0,0
FXREN: DB 0,'XREN?   ','DAT',0,0,0,0
FOPNREN: DB 0,'OPNREN  ','DAT',0,0,0,0
; source 16 bytes then destination 16 bytes (destination drive byte zero)
ROLDNEW: DB 0,'OLDNAME ','DAT',0,0,0,0, 0,'NEWNAME ','DAT',0,0,0,0
RSRCDEST: DB 0,'SRCFILE ','DAT',0,0,0,0, 0,'DEST    ','DAT',0,0,0,0
RNOSRC: DB 0,'NOSRC   ','DAT',0,0,0,0, 0,'WONT    ','DAT',0,0,0,0
RWILD: DB 0,'WREN?   ','DAT',0,0,0,0, 0,'XREN?   ','DAT',0,0,0,0
RBOLDNEW: DB 2,'BOLD    ','DAT',0,0,0,0, 0,'BNEW    ','DAT',0,0,0,0
ROPNREN: DB 0,'OPNREN  ','DAT',0,0,0,0, 0,'OPNNEW  ','DAT',0,0,0,0

HEADER: DB 'DELREN012 result current fcb[33] dma0',13,10,'$'
LSDB: DB 'SEARCH-DEL-BEFORE ',0
LDELONE: DB 'DELETE-ONE ',0
LSDA: DB 'SEARCH-DEL-AFTER ',0
LDELNO: DB 'DELETE-NONE ',0
LSWB: DB 'SEARCH-WILD-BEFORE ',0
LDELWILD: DB 'DELETE-WILDCARD ',0
LSWA: DB 'SEARCH-WILD-AFTER ',0
LOPENDEL: DB 'OPEN-AFTER-DELETE ',0
LSRB: DB 'SEARCH-REUSE-BEFORE ',0
LREWRITE: DB 'RECREATE-WRITE ',0
LSRA: DB 'SEARCH-REUSE-AFTER ',0
LBDEL: DB 'DELETE-B ',0
LU0DEL: DB 'USER0-DELETE-U1 ',0
LU1DEL: DB 'USER1-DELETE-U1 ',0
LRENAME: DB 'RENAME-SIMPLE ',0
LSOLD: DB 'SEARCH-OLD ',0
LSNEW: DB 'SEARCH-NEW ',0
LRENDEST: DB 'RENAME-TO-EXISTING ',0
LRENNONE: DB 'RENAME-NONE ',0
LRENWILD: DB 'RENAME-WILDCARD ',0
LSXREN: DB 'SEARCH-XREN ',0
LBREN: DB 'RENAME-B ',0
LOPNREN: DB 'OPEN-AFTER-RENAME ',0

RESULT: DB 0
CURDISK: DB 0
FCB: DS 36,0
SAVEDFCB: DS 36,0
BUF: DS 128,0
	DS 160
STACKTOP:
	END START
