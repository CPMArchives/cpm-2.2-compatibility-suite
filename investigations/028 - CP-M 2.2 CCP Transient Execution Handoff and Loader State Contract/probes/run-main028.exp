#!/usr/bin/expect -f
set diskdir [lindex $argv 0]
set logfile [lindex $argv 1]
set timeout 90
log_file -noappend $logfile
spawn cpmsim -z -d $diskdir
expect "A>"
foreach cmd {B:MIN28 B:MEM28 B:LOAD28 B:MEM28 {B:ENTRY28 ONE TWO} B:ERROR28 B:NOFILE28 B:BIGERR28} {
 send -- "$cmd\r"
 expect "A>"
}
send "\034"
expect eof
