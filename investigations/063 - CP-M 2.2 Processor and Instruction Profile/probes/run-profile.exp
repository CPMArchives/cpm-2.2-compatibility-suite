#!/usr/bin/expect -f
set timeout 20
if {$argc != 5} {
    puts stderr "usage: run-profile.exp DISKDIR CPU EXTRA COMMANDS TRANSCRIPT"
    exit 2
}
set diskdir [lindex $argv 0]
set cpu [lindex $argv 1]
set extra [lindex $argv 2]
set commands [split [lindex $argv 3] ,]
set transcript [lindex $argv 4]
log_file -noappend $transcript
set args [list cpmsim $cpu -d $diskdir]
if {$extra ne "none"} {
    foreach part [split $extra ,] { lappend args $part }
}
spawn {*}$args
expect -re {A>}
foreach command $commands {
    send -- "$command\r"
    expect {
        -re {A>} {}
        -re {User Interrupt|HALT instruction|system halted|illegal|undocumented} {
            send -- "\034"
            expect eof
            exit 0
        }
        timeout {
            send -- "\034"
            expect eof
            exit 0
        }
        eof { exit 0 }
    }
}
send -- "\034"
expect eof
