                       1      1 ; Investigation 004: BDOS function 6 and 11 probe.
                       2      2 ; Assemble: z80asm -fb -oDIO004.COM DIO004.ASM
                       3      3 ;
                       4      4 ; Modes are selected by the first command-tail operand:
                       5      5 ;   E  no queued key: record functions 11, 6/FF, and 6/FE results
                       6      6 ;   6  scripted BIOS makes one byte ready: function 6/FF consumes it
                       7      7 ;   S  scripted BIOS makes one byte ready: function 11 observes and buffers it,
                       8      8 ;      a second function 11 re-observes it, then function 6/FF tests whether
                       9      9 ;      direct input consumes the BDOS pending-key buffer.
                      10     10 ;   F  scripted BIOS makes one byte ready: undocumented function 6/FE status.
                      11     11 ;   O  emit framed direct-output bytes including TAB, '$', and Ctrl-P.
                      12     12
                      13     13 	ORG	0100H
                      14     14
