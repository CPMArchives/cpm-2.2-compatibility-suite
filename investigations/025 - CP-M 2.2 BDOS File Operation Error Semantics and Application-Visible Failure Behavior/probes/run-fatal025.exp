#!/usr/bin/expect -f
set diskdir [lindex $argv 0]
set logfile [lindex $argv 1]
set command [lindex $argv 2]
set pattern [lindex $argv 3]
set timeout 60
log_file -noappend $logfile
spawn cpmsim -z -d $diskdir
expect "A>"
send -- "$command\r"
expect -exact "$pattern"
send "\003"
expect "A>"
send "\034"
expect eof

