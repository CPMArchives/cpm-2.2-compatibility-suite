	.Z80
	TITLE		PROM-PROGRAMMER: USER PATCH AREA, DATE: 19.11.82
	SUBTTL		DURCH DEN BENUTZER VERAENDERBARE ROUTINEN
;
; CREATION DATE:	14.7.82		MODIFIKATION DATE:	19.11.82
;
; VERSION 1.0		FREIGEGEBEN AM: 19.11.82 MIT FOLGENDEN EINSCHR[NKUNGEN:
;					NUR ADM3A, ADDS VIEWPOINT UND MD820 WURDEN GETESTET!
;					NUR 4 MHZ SYSTEMTAKT WURDE GETESTET!
;					NUR INT EQU 0 WURDE GETESTET!
;
;
; <C> 1982 BY JANICH & KLASS COMPUTERSYSTEME WUPPERTAL
;	      ALL RIGTHS RESERVED WORLDWIDE
;
;
MENTRY	EQU	200H	; EINSPRUNGADRESSE PROM-PROGRAMMER VERSION 1.0
;ABS	EQU	0	; RELATIVE ASSEMBLIERUNG (NICHT FUER DEN BENUTZER)
ABS	EQU	1	; ABSOLUTE ASSEMBLIERUNG (ZUM PATCHEN NOTWENDIG!)
MHZ	EQU	4	; SYSTEMTAKT 4 MHZ
;MHZ	EQU	25	; SYSTEMTAKT 2,5 MHZ
INT	EQU	0	; KEINE INTERRUPTS ZU ERWARTEN
;INT	EQU	1	; INTERRUPTS SIND MOEGLICH
IOBASE	EQU	14H	; BASIS I/O-ADRESSE DER PROMMER-PLATINE IM SYSTEM
TBASE	EQU	100H	; TRANSIENT-BASE
BDOS	EQU	5	; BDOS CALL
CONOUT	EQU	2	; CONSOLE OUTPUT
PRTSTR	EQU	9	; PRINT STRING
CR	EQU	13	; CARRIAGE RETURN
LF	EQU	10	; LINE FEED
TAB	EQU	9	; TABULATOR
;
	ENTRY	CURSOR,CRTCUR,CRTOUT,CRTSTR,CRLF,CLS,DATE,TIME,IOBAS,RESET
	ENTRY	INPLIN,TERMM,FREQM,WAIT,WAIT0
;
	PAGE	65
;
; TERMINALTYPE:
;
;ADDSV	EQU	1	; ADDS VIEWPOINT TERMINAL
ADDSV	EQU	0
ADM3A	EQU	1	; ADM 3A TERMINAL
;ADM3A	EQU	0
;HAZ	EQU	1	; HAZELTINE 1500 TERMINAL
HAZ	EQU	0
;BEE	EQU	1	; BEEHIVE 150 TERMINAL
BEE	EQU	0
;MD820	EQU	1	; KDE-820 (MAGIRUS MD 820) TERMINAL
MD820	EQU	0
;HKM	EQU	1	; HKM-VIEDEO-PLATINE
HKM	EQU	0
;NONE	EQU	1	; KEINES DER OBEREN TERMINALS
NONE	EQU	0
;
	IF	ADDSV+ADM3A+HAZ+BEE+MD820+HKM+NONE GT 1
	.PRINTX	/MEHR ALS EIN TERMINAL DEFINIERT/
	ERROR
	ENDIF
;
; ESCAPE-SEQUENZEN FUER DIE CURSOR-STEUERUNG MIT: ESC,ESC2,Y+20H,X+20H
;
	IFF	HAZ
ESC	EQU	1BH	; ESCAPE
	ENDIF
	IF	ADM3A OR HKM
ESC2	EQU	'='
	ENDIF
	IF	ADDSV OR MD820
ESC2	EQU	'Y'
	ENDIF
	IF	BEE
ESC2	EQU	'F'
	ENDIF
;
; CLEAR SCREEN CHARACTER, FALLS NUR EIN CHARACTER DAFUER NOTWENDIG IST
;
	IF	ADDSV
CLSC	EQU	0CH		; FORMFEED
	ENDIF
	IF	ADM3A OR HKM
CLSC	EQU	1AH		; CONTROL Z
	ENDIF
;
; CLEAR SCREEN CHARACTER, FALLS ZWEI CHARACTER DAFUER NOTWENDIG SIND
;
	IF	HAZ
ESC	EQU	7EH		; TILDE CHARACTER
ESC2	EQU	11H		; ESCAPE 2 FUER CURSORPOSITIONIERUNG
CLSC	EQU	ESC
CLSC2	EQU	1CH		; CLEAR SCREEN CODE
	ENDIF
	IF	BEE
CLSC	EQU	ESC
CLSC2	EQU	'E'
	ENDIF
	IF	MD820
CLSC	EQU	ESC
CLSC2	EQU	'J'		; CLEAR SCREEN CODE MD820
	ENDIF
;
; SPRUNGLEISTE
;
	IF	ABS
	ASEG
	.PRINTX	/ABSOLUTE ASSEMBLIERUNG/
	ORG	TBASE
	JP	MENTRY		; SPRUNG AUF DEN PROGRAMMANFANG
	ELSE
	.PRINTX	/RELATIVE ASSEMBLIERUNG/
	CSEG
	ENDIF
CURSOR:	JP	CUR		; CURSOR-POSITIONIERUNG
CRTCUR:	JP	CRTCX		; STRINGAUSGABE MIT CURSORPOSITIONIERUNG
CRTOUT:	JP	CRTOX		; AUSGABE EINES ASCII-ZEICHENS AUF DIE CONSOLE
CRTSTR:	JP	CRTSX		; AUSGABE EINES ASCII-STRINGS AUF DIE CONSOLE
CRLF:	JP	CRLFX		; AUSGABE VON CARRIAGE RETURN UND LINEFEED AUF DIE CONSOLE
CLS:	JP	CLSX		; CLEAR SCREEN
DATE:	JP	DATUM		; DATUM ABFRAGEN
TIME:	JP	ZEIT		; UHRZEIT ABFRAGEN
IOBAS:	JP	IOBASX		; I/O-BASIS-ADRESSE PROMMER INS C-REGISTER
RESET:	JP	RESETX		; RESET EPROMSOCKEL (SPANNUNGSVERSORGUNG)
INPLIN:	JP	INPLX		; EINGABEZEILE VON DER TASTATUR
TERMM:	JP	TERMMX		; TERMINAL-MESSAGE (.TERM)
FREQM:	JP	FREQMX		; FREQUENZ-MESSAGE (.FREQ)
;
; WAIT:	CREATION DATE: 25.01.82	; MODIFIKATION DATE: 15.07.82
;
;	WARTESCHLEIFE VON  N * 1 MILLISEKUNDE
;
; ENTRIES:
;
; WAIT	- WARTESCHLEIFE N * 1 MILLISEKUNDE
; WAIT0	- WARTESCHLEIFE N * 1 MILLISEKUNDE
;
; EINGABEREGISTER:
;
; HL - .N (NUR BEI WAIT)
; DE - N  (NUR BEI WAIT0)
;
; FORTRAN 80 - CALL:
;
;	CALL WAIT (N)
;
; ZERSTOERT: AF,BC,DE,HL
;
;
	IFE	MHZ-4	; 4   MHZ - SYSTEM
KONST1	EQU	2
KONST2	EQU	150
	IF1
	.PRINTX 'WAIT FOR 4 MHZ'
	ENDIF
	ENDIF
	IFE	MHZ-25	; 2,5 MHZ - SYSTEM
KONST1	EQU	8
KONST2	EQU	21
	IF1
	.PRINTX 'WAIT FOR 2.5 MHZ'
	ENDIF
	ENDIF
WAIT:
	IFT	INT	; INTERRUPTS MOEGLICH ?
	DI
	IF1
	.PRINTX 'INTERRUPTS TEMPORARY DISABELT!!'
	ENDIF
	ELSE
	NOP		; FILLER
	IF1
	.PRINTX 'NO INTERRUPTS ALLOWED'
	ENDIF
	ENDIF
;
; LOAD N FROM MEMORY
;
	LD	E,(HL)	; 4 MHZ: 1.75 US ; 2.5 MHZ: 2.8 US
	INC	HL	; 4 MHZ: 1.5  US ; 2.5 MHZ: 2.4 US
	LD	D,(HL)	; 4 MHZ: 1.75 US ; 2.5 MHZ: 2.8 US
WAIT0:
	IFT	INT	; INTERRUPTS MOEGLICH ?
	DI
	ENDIF
;
; LOOP N TIMES
;
LOOP0:	LD	B,KONST1	; 4 MHZ: 1.75 US ; 2.5 MHZ: 2.8 US
LOOP1:	PUSH	BC		; 4 MHZ: 2.75 US ; 2.5 MHZ: 4.4 US
	LD	B,KONST2	; 4 MHZ: 1.75 US ; 2.5 MHZ: 2.8 US
LOOP2:	DJNZ	LOOP2		; 4 MHZ: 3.25 US ; 2.5 MHZ: 5.2 US
				; 4 MHZ: 2.00 US ; 2.5 MHZ: 3.2 US (LAST)
	POP	BC		; 4 MHZ: 2.5  US ; 2.5 MHZ: 4.0 US
	DJNZ	LOOP1		; 4 MHZ: 3.25 US ; 2.5 MHZ: 5.2 US
				; 4 MHZ: 2.00 US ; 2.5 MHZ: 3.2 US (LAST)
	DEC	DE		; 4 MHZ: 1.5  US ; 2.5 MHZ: 2.4 US
;
; TEST IF DE = 0
;
	LD	A,D		; 4 MHZ: 1.00 US ; 2.5 MHZ: 1.6 US
	OR	E		; 4 MHZ: 1.00 US ; 2.5 MHZ: 1.6 US
	JR	NZ,LOOP0	; 4 MHZ: 3.00 US ; 2.5 MHZ: 4.8 US (NOT ZERRO)
				; 4 MHZ: 1.75 US ; 2.5 MHZ: 2.8 US (ZERRO)
	IFT	INT	; INTERRUPTS MOEGLICH ?
	EI
	ENDIF
	RET			; 4 MHZ: 2.5  US ; 2.5 MHZ: 4.0 US
;	CALL	WAIT		; 4 MHZ: 4.25 US ; 2.5 MHZ: 6.8 US
;
; CURSORPOSITIONIERUNG
;
; EINGABEREGISTER:
;
; HL:	.ZEILE
; DE:	.SPALTE
;
; FORTRAN 80 CALL:	CALL CURSOR (ZEILE,SPALTE)
;
; ZERSTOERT: AF,BC,DE,HL
;
CUR:
	IF	ADDSV OR ADM3A OR HKM OR BEE OR MD820 OR HAZ
	PUSH	DE		; SAVE .SPALTE
	PUSH	HL		; SAVE .ZEILE
	LD	A,ESC		; ESCAPE CODE
	CALL	OUTCHR		; CHARACTER AUSGABE
	LD	A,ESC2		; ESCAPE CODE 2
	CALL	OUTCHR
	POP	HL		; RESTORE .ZEILE
	LD	A,(HL)		; A = ZEILE
	IFF	HAZ		; KEIN OFFSET BEI HAZELTINE 1500
	ADD	A,20H-1		; ADD OFFSET
	ENDIF
	CALL	OUTCHR
	POP	HL		; RESTORE .SPALTE
	LD	A,(HL)		; A = SPALTE
	IFF	HAZ		; KEIN OFFSET BEI HAZELTINE 1500
	ADD	A,20H-1		; ADD OFFSET
	ENDIF
	JP	OUTCHR		; CHARACTER OUT + EXIT
	ENDIF
	IF	NONE
;
; CURSOR POSITIONIERUNG MUSS HIER EINGEFUEGT WERDEN, FALLS KEINES DER
; HIER BEKANNTEN TERMINALS SELEKTIERT WURDE
;
	RET
	ENDIF
;
; STRINGAUSGABE MIT CURSORPOSITIONIERUNG
;
; EINGABEREGISTER:
;
; HL:	.ZEILE
; DE:	.SPALTE
; BC:	.STRING
;
; FORTRAN 80 CALL:	CALL CRTCUR (ZEILE,SPALTE,STRING)
;
; ZERSTOERT: AF,BC,DE,HL
;
CRTCX:	PUSH	BC		; SAVE .STRING
	CALL	CURSOR		; CURSOR POSITIONIEREN
	POP	HL		; HL = .STRING
	JP	CRTSTR		; OUTPUT & EXIT
;
; CLEAR SCREEN
;
; FORTRAN 80 CALL:	CALL CLS
;
; ZERSTOERT: AF,BC,DE,HL
;
CLSX:
	IF	ADDSV OR ADM3A OR HAZ OR BEE OR MD820 OR HKM
	LD	A,CLSC		; CLEAR SCREEN CHARACTER
	IF	HAZ OR BEE OR MD820
	CALL	OUTCHR
	LD	A,CLSC2		; CLEAR SCREEN CHARACTER 2
	ENDIF
	JP	OUTCHR		; CHARACTER OUT + EXIT
	ENDIF
	IF	NONE
;
; CLEAR SCREEN ROUTINE MUSS HIER EINGEFUEGT WERDEN, FALLS KEINES DER HIER
; BEKANNTEN TERMINALS SELEKTIERT WURDE
;
	RET
	ENDIF
;
; DATUMABFRAGE
;
; EINGABEREGISTER:
;
; HL:	POINTER AUF EINGABEPUFFER  (SIEHE INPLIN!!)
;
; FORTRAN 80 CALL:	CALL DATE (BUFFER)
;
; ZERSTOERT: AF,BC,DE,HL
;
DATUM:
	IF	HKM
;
; DATUM AUF DER VIEDEO PLATINE AUSLESEN
;
	RET
	ELSE
;
; DATUM VON HAND EINGEBEN
;
	PUSH	HL		; SAVE POINTER OF BUFFER
	LD	HL,DATM		; 'BITTE DATUM EINGEBEN'
	CALL	CRTSTR		; AUF DEN BILDSCHIRM AUSGEBEN
	POP	HL		; HL = .BUFFER
	JP	INPLIN		; LINE INPUT AND EXIT
DATM:	DEFM	'BITTE DATUM EINGEBEN: $'
	ENDIF
;
; UHRZEIT ABFRAGEN
;
; EINGABEREGISTER:
;
; HL:	POINTER AUF UHRZEITPUFFER
;	DIE UHRZEIT IST IN DER FORM: 'HH:MM:SS' IN DEN PUFFER EINZUTRAGEN
;	DER PUFFER HAT EINE LAENGE VON 8 BYTE.
;
; AUSGABEREGISTER:
;
; A:	A = 255	- UHR IST IM SYSTEM VORHANDEN
;	A = 0	- KEINE UHR IM SYSTEM VORHANDEN
;
; FORTRAN 80 CALL:	CALL TIME (BUFFER)
;
; ZERSTOERT: AF,BC,DE,HL
;
ZEIT:
	IF	HKM
;
; UHRZEIT VON DER VIDEO PLATINE AUSLESEN
;
	LD	A,255		; UHR IST VORHANDEN
	RET
	ELSE
;
; KEINE UHR IM SYSTEM VORHANDEN
;
	XOR	A		; KEINE UHR VORHANDEN
	RET
	ENDIF
;
; I/O-BASISADRESSE INS C REGISTER LADEN
;
IOBASX:	LD	C,IOBASE
	RET
;
; STATUSBITS FUER EPROMS AUF NULL SETZEN
;
; FORTRAN 80 CALL:	CALL RESET
;
; ZERSTOERT: AF
;
RESETX:	XOR	A		; A = 0
	OUT	(IOBASE+3),A	; IOBASE+3 = ADDRESS UPPER & STATUS
	RET
;
;INPLIN: LINE INPUT       
;
; CREATION DATE: 10.4.82	; MODIFIKATION DATE: 15.7.82
;
;	ROUTINE ZUM EINGEBEN EINER INPUTZEILE.
;	DIE INPUTZEILE WIRD IN EINEM DURCH HL ADRESSIERTEN PUFFER EINGETRAGEN.
;	INPLIN ARBEITET MIT DER CP/M-FUNKTION 10: READ CONSOLE BUFFER
;
; EINGABEREGISTER:
;
; HL	- POINTER AUF EINGABEPUFFER
;
; BEMERKUNG:
;		DIE EINGABEZEILE BEGINNT ERST IM 3. BYTE DES EINGABEPUFFERS!
;		DIE ERSTEN ZWEI BYTE HABEN FOLGENDE BEDEUTUNG:
;		1. BYTE: MX (EINGABEWERT): MAXIMALE ANZAHL DER EINZUGEBENDEN ZEICHEN
;		2. BYTE: NC (AUSGABEWERT): ANZAHL DER TATSAECHLICH EINGEGEBENEN ZEICHEN
;		(SIEHE BESCHREIBUNG VON FUNKTION 10: READ CONSOLE BUFFER)
;
; FORTRAN 80 CALL: 	CALL INPLIN (BUFFER)
;
; ZERSTOERT: AF,BC,DE,HL
;
;
INPLX:	EX	DE,HL		; DE = .BUFFER
	LD	C,10		; READ CONSOLE BUFFER
	JP	BDOS		; CALL BDOS ; RET
;
; .TERMINALMESSAGE NACH HL LADEN
;
TERMMX:	LD	HL,TERM
	RET
;
; .FREQUENZMESSAGE NACH HL LADEN
;
FREQMX:	LD	HL,FREQ
	RET
;
; CHARACTER OUTPUT AUF DIE CONSOLE
;
; EINGABEREGISTER:
;
; HL:	POINTER AUF CHARACTER
;
; FORTRAN 80 CALL:	CALL CRTOUT (CHAR)
;
; ZERSTOERT: AF,BC,DE,HL
;
CRTOX:	LD	A,(HL)		; A = AUSZUGEBENDES ZEICHEN
;
OUTCHR:	LD	E,A		; CHARACTER NACH E
	LD	C,CONOUT	; CONSOLE OUTPUT
	JP	BDOS		; CALL BDOS , RET
;
; AUSGABE EINES ASCII-STRINGS AN DIE CONSOLE
;
; EINGABEREGISTER:
;
; HL:	.STRING
;
; BEMERKUNG: DER STRING MUSS MIT EINEM '$' ABGESCHLOSSEN SEIN
;
; FORTRAN 80 CALL:	CALL CRTSTR (STRING)
;
; ZERSTOERT: AF,BC,DE,HL
;
CRTSX:	EX	DE,HL		; DE = .STRING
	LD	C,PRTSTR	; PRINT STRING (CP/M)
	JP	BDOS		; OUTPUT & EXIT
;
; AUSGABE VON CR,LF AN DIE CONSOLE
;
; FORTRAN 80 CALL:	CALL CRLF
;
; ZERSTOERT: AF,BC,DE,HL
;
CRLFX:	LD	A,CR		; A = CR
	CALL	OUTCHR		; OUTPUT
	LD	A,LF		; A = LF
	JP	OUTCHR		; OUTPUT & EXIT
;
; MESSAGES
;
TERM:				; TERMINAL MESSAGE
	DEFM	CR,LF,TAB,TAB
	IF	ADDSV
	DEFM	'ADDS VIEWPOINT TERMINAL$'
	IF1
	.PRINTX 'ADDS VIEWPOINT TERMINAL'
	ENDIF
	ENDIF
	IF	ADM3A
	DEFM	'ADM 3-A TERMINAL$'
	IF1
	.PRINTX 'ADM 3-A TERMINAL'
	ENDIF
	ENDIF
	IF	HAZ
	DEFM	'HAZELTINE 1500 TERMINAL$'
	IF1
	.PRINTX 'HAZELTINE 1500 TERMINAL'
	ENDIF
	ENDIF
	IF	BEE
	DEFM	'BEEHIVE 150 TERMINAL$'
	IF1
	.PRINTX 'BEEHIVE 150 TERMINAL'
	ENDIF
	ENDIF
	IF	MD820
	DEFM	'MAGIRUS MD 820 TERMINAL$'
	IF1
	.PRINTX 'KDE 820 (=MAGIRUS MD 820) TERMINAL'
	ENDIF
	ENDIF
	IF	HKM
	DEFM	'HKM VIEDEO PLATINE$'
	IF1
	.PRINTX 'HKM VIEDEO PLATINE'
	ENDIF
	ENDIF
	IF	NONE
	DEFM	'USER TERMINAL ROUTINE$'
	IF1
	.PRINTX 'USER TERMINAL ROUTINE'
	ENDIF
	ENDIF
;
FREQ:				; FREQUENZMESSAGE
	DEFM	CR,LF,TAB,TAB,'SYSTEMTAKT = '
	IFF	MHZ-4
	DEFM	'4 MHZ$'
	ELSE
	DEFM	'2,5 MHZ$'
	ENDIF
;
; ENDE MUSS AUF ADRESSE 200H BEI ABSOLUTER ASSEMBLIERUNG UND
; AUF ADRESSE 0FDH BEI RELATIVER ASSEMBLIERUNG ZEIGEN
;
	IF	ABS
	IF	$ GT 200H
	.PRINTX	'*** PROGRAMMADRESSE ZU GROSS! KANN NICHT GEPATCHT WERDEN! ***'
	ENDIF		; $ GT 200H
;
; ADRESSE GERADE SETZEN
;
	IF	$ MOD 2
	NOP
	ENDIF			; ADRESSE IST JETZT GERADE
	IF	$ LT 200H
	REPT	(200H-$)/2
	DEFW	0		; FILLER
	ENDM
	ENDIF			; $ LT 200H
	ELSE
	ORG	0FCH
	NOP			; ADRESSE MUSS AUF 0FCH RELATIV ZEIGEN
	ENDIF			; ABS
;
ENDE	EQU	$		; 0FDH RELATIV ODER 200H ABSOLUT
;
	END
