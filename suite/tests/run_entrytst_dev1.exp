#!/usr/bin/expect -f
# SPDX-License-Identifier: GPL-2.0-or-later
set diskdir [lindex $argv 0]
set logfile [lindex $argv 1]
set cpu [lindex $argv 2]
if {$cpu eq ""} { set cpu "-z" }
set timeout 60
log_file -noappend $logfile
source [file join [file dirname [info script]] cpmsim-path.exp]
spawn $cpmsim $cpu -d $diskdir
expect "A>"
send -- "B:\r"
expect "B>"
send -- "ENTRYTST /SAFE\r"
expect "Summary: 25 pass, 0 fail, 0 error, 0 observations"
expect "B>"
send -- "ENTRYTST /ALL\r"
expect "0032  PASS"
expect "0033  PASS"
expect "0539  PASS"
expect "0589  PASS"
expect "0599  PASS"
expect "0610  PASS"
expect "0614  PASS"
expect "0615  PASS"
expect "0617  PASS"
expect "0619  PASS"
expect "Summary: 41 pass, 0 fail, 0 error, 16 observations"
expect "B>"
send -- "ENTRYTST /LIST\r"
expect "0001  .COM load origin"
expect "0619  Private BDOS target is not an application gateway"
expect "B>"
send -- "ENTRYTST /H\r"
expect "ENTRYTST 0.1.0-dev8"
expect "B>"
send -- "ENTRYTST /0012 SECOND.BIN\r"
expect "0012  PASS      PROFILE"
expect "B>"
send -- "ENTRYTST /0014 A:AB*.C?M\r"
expect "0014  PASS      REQUIRED"
expect "B>"
send -- "ENTRYTST /0015 mixed.txt\r"
expect "0015  PASS      REQUIRED"
expect "B>"
send -- "ENTRYTST /0020 mixed Case\r"
expect "0020  PASS      REQUIRED"
expect "B>"
send -- "ENTRYTST /0026\r"
expect "SUCCESS: control returns to the CCP with a usable prompt."
expect "Press Enter to run the test:"
send -- "\r"
expect "B>"
send -- "ENTRYTST /0027\r"
expect "SUCCESS: control returns to the CCP with a usable prompt."
expect "Press Enter to run the test:"
send -- "\r"
expect "B>"
send -- "ENTRYTST /0595\r"
expect "SUCCESS: CP/M reconstructs a usable CCP prompt."
expect "Press Enter to run the test:"
send -- "\r"
expect "B>"
send "\034"
expect eof
