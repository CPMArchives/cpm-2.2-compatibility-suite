#!/usr/bin/expect -f
# SPDX-License-Identifier: GPL-2.0-or-later
set diskdir [lindex $argv 0]
set logfile [lindex $argv 1]
set cpu [lindex $argv 2]
if {$cpu eq ""} { set cpu "-z" }
set timeout 30
log_file -noappend $logfile
source [file join [file dirname [info script]] cpmsim-path.exp]
spawn $cpmsim $cpu -d $diskdir
expect "A>"
send -- "B:\r"
expect "B>"
send -- "CONSTEST /ALL\r"
set probes {
    {Probe 0052: Function 2 output between brackets: [A] expected [A]}
    {Probe 0053: Function 2 output between brackets: [$] expected one dollar-sign character}
    {Probe 0054: Function 9 output between brackets: [F9ADDR] expected [F9ADDR]}
    {Probe 0055: Function 9 termination: [LEFT] expected [LEFT]}
    {Probe 0056: Function 9 terminator not emitted: [X] expected [X]}
    {Probe 0057: Function 9 empty string: [] expected []}
    {Probe 0058: Function 9 control characters follow:}
    {Probe 0059: Function 2 formatted TAB on next line:}
    {Probe 0060: Function 9 formatted TAB on next line:}
    {Probe 0061: Function 2 A plus Function 9 TAB/B:}
}
set items {0052 0053 0054 0055 0056 0057 0058 0059 0060 0061}
foreach probe $probes item $items {
    expect -exact $probe
    expect "Observed exactly as described? (Y/N; no Enter) "
    send -- "Y"
    expect "$item  PASS"
}
expect "Summary: 10 pass, 0 fail, 0 error, 0 observations"
expect "B>"
send -- "CONSTEST /0052 /REPORT\r"
expect -exact {Probe 0052: Function 2 output between brackets: [A] expected [A]}
expect "Observed exactly as described? (Y/N; no Enter) "
send -- "Y"
expect "CASE BDOS-CON-001-P0052"
expect "LEDGER 0052"
expect "RESULT PASS"
expect "Summary: 1 pass, 0 fail, 0 error, 0 observations"
expect "B>"
send -- "CONSTEST /LIST\r"
expect "Coverage: 10 implemented of 87 CONSTEST catalog cases"
expect "Remaining: 77"
expect "B>"
send -- "CONSTEST /H\r"
expect "CONSTEST 0.1.0-dev1"
expect "B>"
send "\034"
expect eof
