foreach cmd {"FILETEST /0163" "FILETEST /CASE:BDOS-FILE-001-P0163" "FILETEST /0182" "FILETEST /CASE:BDOS-FILE-002-P0182" "FILETEST /0183" "FILETEST /CASE:BDOS-FILE-001-P0183" "FILETEST /0244" "FILETEST /CASE:BDOS-FILE-004-P0244" "FILETEST /0245" "FILETEST /CASE:BDOS-FILE-004-P0245" "FILETEST /0256" "FILETEST /CASE:BDOS-FILE-011-P0256" "FILETEST /0257" "FILETEST /CASE:BDOS-FILE-005-P0257" "FILETEST /0265" "FILETEST /CASE:BDOS-FILE-005-P0265" "FILETEST /0270" "FILETEST /CASE:BDOS-FILE-011-P0270" "FILETEST /0277" "FILETEST /CASE:BDOS-FILE-002-P0277" "FILETEST /0280" "FILETEST /CASE:BDOS-FILE-002-P0280" "FILETEST /0281" "FILETEST /CASE:BDOS-FILE-005-P0281" "FILETEST /0325" "FILETEST /CASE:BDOS-FILE-007-P0325" "FILETEST /0334" "FILETEST /CASE:BDOS-FILE-008-P0334" "FILETEST /0352" "FILETEST /CASE:BDOS-FILE-006-P0352" "FILETEST /0372" "FILETEST /CASE:BDOS-FILE-006-P0372" "FILETEST /0388" "FILETEST /CASE:BDOS-FILE-006-P0388" "FILETEST /0552" "FILETEST /CASE:BDOS-FILE-011-P0552" "FILETEST /0554" "FILETEST /CASE:BDOS-FILE-011-P0554"} {
