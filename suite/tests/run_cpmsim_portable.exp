foreach cmd {"FILETEST /0346" "FILETEST /CASE:BDOS-FILE-008-P0346" "FILETEST /0347" "FILETEST /CASE:BDOS-FILE-009-P0347" "FILETEST /0348" "FILETEST /CASE:BDOS-FILE-006-P0348" "FILETEST /0349" "FILETEST /CASE:BDOS-FILE-007-P0349" "FILETEST /0350" "FILETEST /CASE:BDOS-FILE-008-P0350" "FILETEST /0351" "FILETEST /CASE:BDOS-FILE-009-P0351" "FILETEST /0550" "FILETEST /CASE:BDOS-FILE-011-P0550" "FILETEST /0551" "FILETEST /CASE:BDOS-FILE-011-P0551"} {
