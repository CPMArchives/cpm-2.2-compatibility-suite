#!/usr/bin/expect -f
# SPDX-License-Identifier: GPL-2.0-or-later
set diskdir [lindex $argv 0]
set logfile [lindex $argv 1]
set cpu [lindex $argv 2]
if {$cpu eq ""} { set cpu "-z" }
set timeout 60
log_file -noappend $logfile
source [file join [file dirname [info script]] cpmsim-path.exp]
spawn $cpmsim $cpu -d $diskdir
expect "A>"
send -- "B:\r"
expect "B>"
send -- "BDOSTEST /SAFE\r"
expect "Summary: 56 pass, 0 fail, 0 error, 0 observations"
expect "B>"
send -- "BDOSTEST /ALL\r"
expect "0034  UNTEST"
expect "0131  UNTEST"
expect "0154  UNTESTED"
expect "0195  PASS"
expect "0413  UNTEST"
expect "0521  PASS"
expect "0532  PASS"
expect "Summary: 70 pass, 0 fail, 0 error, 14 observations"
expect "B>"
send -- "BDOSTEST /LIST\r"
expect "0034  Exact BIOS/BDOS vector targets"
expect "0532  Invalid parameters are function-specific"
expect "B>"
send -- "BDOSTEST /H\r"
expect "BDOSTEST 1.0.0-dev8"
expect "B>"
send "\034"
expect eof
