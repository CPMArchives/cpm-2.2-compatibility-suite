#!/usr/bin/expect -f
# SPDX-License-Identifier: GPL-2.0-or-later
set diskdir [lindex $argv 0]
set logfile [lindex $argv 1]
set cpu [lindex $argv 2]
if {$cpu eq ""} { set cpu "-z" }
set timeout 30
log_file -noappend $logfile
source [file join [file dirname [info script]] cpmsim-path.exp]
spawn $cpmsim $cpu -d $diskdir
expect "A>"
send -- "B:\r"
expect "B>"
send -- "CCPTEST /SAFE\r"
expect "Summary: 12 pass, 0 fail, 0 error, 0 observations"
expect "B>"
send -- "CCPTEST /ALL\r"
expect "0013  UNTESTED  REQUIRED      Run: CCPTEST /0013 B:ALPHA.TXT"
expect "0016  PASS      NOT GUAR."
expect "0025  UNTESTED  REQUIRED      Run: CCPTEST /0025"
expect "Summary: 21 pass, 0 fail, 0 error, 9 observations"
expect "B>"
send -- "CCPTEST /H\r"
expect "Show this command summary"
expect "B>"
send -- "CCPTEST /H:RESULTS\r"
expect "STATUS is the outcome: PASS, FAIL, or UNTESTED."
expect "CLASS describes applicability, not the outcome:"
expect "PROFILE=required only when the named profile is claimed."
expect "OUT SCOPE=CCPTEST cannot execute or judge the catalog item."
expect "OBSERVED gives evidence or the command still required."
expect "B>"
send -- "CCPTEST /H:PROFILES\r"
expect "DRI-CCP: strict DRI command-capacity behavior (0478)."
expect "DECLARED-CCP: declared command-tail capacity (0508)."
expect "B>"
send -- "CCPTEST /ALL\r"
expect "0478  UNTESTED  PROFILE       DRI-CCP: Run CCPTEST /0478"
expect "0490  UNTESTED  PROFILE       DRI-DIAG-PRES: Run CCPTEST /0490"
expect "B>"
send -- "CCPTEST /LIST\r"
expect "0002  Transient entry point"
expect "0508  Tail capacity bounded by CCP input acquisition"
expect "0621  XSUB buffered-input compatibility"
expect "Coverage: 59 implemented of 59 CCPTEST catalog cases"
expect "B>"
send -- "CCPTEST /0025\r"
expect "Press Enter to run the test:"
send -- "\r"
expect "B>"
send -- "CCPTEST /0028\r"
expect "Press Enter to run the test:"
send -- "\r"
expect "B>"
set cases {
  0475 "SUCCESS: DIR executes, then the current-drive prompt returns."
  0478 "UNAVAILABLE: the selected profile is not strict DRI CCP."
  0482 "Run each command: DIR, ERA, REN, SAVE, TYPE, USER."
  0489 "FAIL: the CCP hangs, crashes, or corrupts the current drive."
  0490 "EXPECTED: the next displayed command line is exactly NOEXIST?"
  0493 "SUCCESS: item 0002 passes and a usable prompt returns."
  0506 "UNAVAILABLE: this profile is not claimed."
  0572 "Answer N and verify both files remain."
  0621 "UNAVAILABLE: XSUB is not supplied by the selected system."
}
foreach {item evidence} $cases {
  send -- "CCPTEST /$item\r"
  expect -exact $evidence
  expect "B>"
}
send -- "CCPTEST /0010\r"
expect "0010  PASS      REQUIRED      BIOS scratch ends before FCB at 005Ch"
expect "B>"
send -- "CCPTEST /0013 B:ALPHA.TXT\r"
expect "0013  PASS      REQUIRED      FCB2 drive=2 and ALPHA.TXT matched"
expect "B>"
send -- "CCPTEST /0492\r"
expect "0492  PASS      REQUIRED      CCPTEST image executed at 0100h"
expect "Summary: 1 pass, 0 fail, 0 error, 0 observations"
expect "B>"
send -- "CCPTEST /0496\r"
expect "0496  PASS      REQUIRED      Sequential COM image fully loaded"
expect "B>"
send "\034"
expect eof
